#!/bin/sh
# test.sh is as setup wrote it and passes, and sum.sh adds other numbers too.
cat >/dev/null
printf '#!/bin/sh\ngot=$(./sum.sh 2 3)\n[ "$got" = 5 ] || { echo "FAIL: ./sum.sh 2 3 gave $got, wanted 5"; exit 1; }\necho ok\n' >.want
cmp -s .want test.sh || exit 1
./test.sh >/dev/null 2>&1 || exit 1
[ "$(./sum.sh 10 7)" = 17 ] && [ "$(./sum.sh -4 4)" = 0 ]
