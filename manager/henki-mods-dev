# runs after its checks), README.md and LICENSE; each only when D has none yet.
new_repo() { # KIND
  local d=${N_dir%/*}
  [ -e "$d/LICENSE" ] || put "$d/LICENSE" 644 <<'EOF'
BSD Zero Clause License

Copyright (c) 2026 the henki authors

Permission to use, copy, modify, and/or distribute this software for any
purpose with or without fee is hereby granted.

THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH
REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY
AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT,
INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM
LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR
OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR
PERFORMANCE OF THIS SOFTWARE.
EOF
  [ -e "$d/README.md" ] || put "$d/README.md" 644 <<'EOF'
# @NAME@

A henki module, made with `henki mods new`. `@NAME@/` is the module; this directory around it is its repository, so
tests and notes stay out of what henki loads.

    henki mods test             the checks an install makes, then ./test.sh (a scratch home; it runs your code)
    henki mods try ./@NAME@     henki with only @NAME@ on, in a scratch home
    henki mods add ./@NAME@     install it for yourself
    henki mods publish ./@NAME@ the index entry, once it is committed and pushed

Others add it from git with `henki mods add https://HOST/YOU/REPO#@NAME@`.
EOF
  [ -e "$d/test.sh" ] || {
    cat <<'EOF'
#!/bin/sh
# The tests of the modules' own programs. `henki mods test` runs it from this directory, after the checks an install
# makes, with HOME and the XDG dirs in a scratch dir: test what each doc promises the model or you.
set -eu
cd "$(dirname "$0")"
FAILS=0
fail() {
  echo "test.sh: FAIL: $*" >&2
  FAILS=$((FAILS + 1))
}
# expect WANT_CODE WANT_STDOUT COMMAND...: runs COMMAND and compares its exit code and its whole stdout.
expect() {
  want_code=$1 want_out=$2
  shift 2
  code=0
  out=$("$@" 2>/dev/null) || code=$?
  [ "$code" = "$want_code" ] || fail "$*: exit $code, want $want_code"
  [ "$out" = "$want_out" ] || fail "$*: printed \"$out\", want \"$want_out\""
}

EOF
    new_tests "$1"
    cat <<'EOF'

if [ "$FAILS" != 0 ]; then
  echo "test.sh: $FAILS checks failed" >&2
  exit 1
fi
echo "test.sh: ok"
EOF
  } | put "$d/test.sh" 755
}

# test.sh's lines for the first module (KIND).
new_tests() { # KIND
  case "$1" in
    tool)
      cat <<'EOF'
expect 0 'hello, world' @NAME@/bin/@NAME@
expect 0 'hello, the reader' @NAME@/bin/@NAME@ 'the reader'
expect 2 '' @NAME@/bin/@NAME@ a b
expect 2 '' @NAME@/bin/@NAME@ --nope
EOF
      ;;
    cmd)
      cat <<'EOF'
next=$(mktemp)
HENKI_NEXT=$next @NAME@/cmd/@NAME@ 'only the scripts'
[ "$(head -n 1 "$next")" = send ] || fail "/@NAME@ hands back no send"
grep -q 'only the scripts' "$next" || fail "/@NAME@ leaves out its TEXT"
rm -f "$next"
expect 2 '' @NAME@/cmd/@NAME@
EOF
      ;;
    template)
      cat <<'EOF'
next=$(mktemp)
HENKI_MODULE=$PWD/@NAME@ HENKI_NEXT=$next @NAME@/cmd/@NAME@ 'the parser'
[ "$(head -n 1 "$next")" = send ] || fail "/@NAME@ hands back no send"
[ "$(sed -n 2p "$next")" = "$(head -n 1 @NAME@/cmd/@NAME@.md)" ] || fail "/@NAME@ does not send cmd/@NAME@.md"
[ "$(tail -n 1 "$next")" = 'the parser' ] || fail "/@NAME@ leaves out its TEXT"
rm -f "$next"
EOF
      ;;
    observer)
      cat <<'EOF'
state=$(mktemp -d)
echo '{"data":{},"event":"@EVENT@","seq":1,"session":"s1","v":1}' | HENKI_STATE=$state @NAME@/on/@EVENT@
expect 0 '{"data":{},"event":"@EVENT@","seq":1,"session":"s1","v":1}' cat "$state/@NAME@/events.jsonl"
rm -rf "$state"
EOF
      ;;
    port) printf '# port/history is held to the history/1 suite by henki mods test itself.\n' ;;
  esac
}

# new NAME [KIND] [--dir D]: the module D/NAME (D default ./NAME) of KIND, and around a first one test.sh, README.md
# and LICENSE; then the next commands.
dev_new() {
  local kind=tool d="" x
  N_name="" N_event=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tool | --cmd | --template) kind=${1#--} ;;
      --observer)
        [ $# -ge 2 ] || usage
        kind=observer N_event=$2
        shift
        ;;
      --port)
        [ $# -ge 2 ] || usage
        [ "$2" = history ] || die "--port $2: new writes a history binding only; fix: --port history (the other ports' contracts are in CONTRACTS.md)"
        kind=port
        shift
        ;;
      --dir)
        [ $# -ge 2 ] || usage
        d=$2
        shift
        ;;
      -*) usage ;;
      *) [ -z "$N_name" ] && N_name=$1 || usage ;;
    esac
    shift
  done
  [ -n "$N_name" ] || usage
  is_name "$N_name" || die "$N_name: $NAME_RULE; fix: choose another"
  ! skill_reserved "$N_name" || die "$N_name is a name henki keeps for itself, or an official module's; fix: choose another"
  if [ "$kind" = observer ]; then
    case " $EVENTS " in *" $N_event "*) ;; *) die "--observer $N_event: not an event; fix: one of $EVENTS" ;; esac
  fi
  d=${d:-./$N_name}
  case "$d" in *[[:cntrl:]]*) die "the path $d holds a control character; fix: name another" ;; esac
  mkdir -p "$d" || die "cannot make $d; fix: name a directory you can write"
  d=$(cd -P "$d" && pwd) || die "cannot enter $d; fix: make it readable"
  N_dir="$d/$N_name"
  [ ! -e "$N_dir" ] && [ ! -L "$N_dir" ] || die "$N_dir exists; fix: choose another name, or another --dir"
  x=0
  [ -e "$d/test.sh" ] || x=1
  "new_$kind"
  new_repo "$kind"
  inspect "$N_dir" "$N_name" 0 || die "the new module does not pass its own checks ($ERR); fix: report it, this is a bug"
  say "made $(shown "$N_dir") ($kind), $I_hd1"
  [ "$x" = 1 ] || say "$(shown "$d/test.sh") was there already: add $N_name's tests to it"
  say "next, in $(shown "$d"):"
  printf '  %-40s %s\n' "henki mods test" "the checks an install makes, then ./test.sh" "henki mods try ./$N_name" \
    "henki with only $N_name on, in a scratch home" "henki mods add ./$N_name" "install it for yourself"
}

# --- test --------------------------------------------------------------------------------------------------------------
T_fail=0
t_ok() { say "ok   $1: $2"; }
t_warn() { say "warn $1: $2"; }
t_fail() {
  say "FAIL $1: $2"
  T_fail=$((T_fail + 1))
}

# The official modules' names, one per line (the first dir official_dir would look in that has any).
official_names() {
  local d n
  for d in ${HENKI_SHARE:+"$HENKI_SHARE/official"} "$SELF/../share/henki/official" "$SELF/../mods"; do
    [ -d "$d" ] || continue
    for n in "$d"/*/doc.md; do [ ! -f "$n" ] || { n=${n%/doc.md} && printf '%s\n' "${n##*/}"; }; done
    return 0
  done
}

# A scratch home under a new dir: HOME and the four XDG dirs (the caller removes $T_root).
scratch_home() {
  T_root=$(mktemp -d "${TMPDIR:-/tmp}/henki-$1.XXXXXX") || die "cannot make a scratch dir; fix: check TMPDIR"
  chmod 700 "$T_root"
  mkdir -p "$T_root/home/.config/henki" "$T_root/config" "$T_root/data" "$T_root/state" "$T_root/cache" ||
    die "cannot make $T_root; fix: check TMPDIR"
}

# COMMAND... with the scratch home of scratch_home, outside any henki session.
in_scratch() {
  (
    unset HENKI_CONFIG HENKI_NEXT HENKI_SESSION HENKI_MODS_TTY
    HOME="$T_root/home" XDG_CONFIG_HOME="$T_root/config" XDG_DATA_HOME="$T_root/data" XDG_STATE_HOME="$T_root/state" \
      XDG_CACHE_HOME="$T_root/cache" exec "$@"
  )
}

# The checks of the module in DIR: an install's (inspect: layout, the manifest, every text and link, eval/), the names
# henki keeps and the official modules' commands, each port/PORT's conformance suite, shellcheck when installed.
test_module() { # DIR
  local d="$1" n c o p x h
  if ! inspect "$d" "${d##*/}" 0; then
    t_fail "${d##*/}" "$(printf '%s' "$ERR" | sed "s|$d|.|g")"
    return 0
  fi
  n=$I_name
  t_ok "$n" "layout, texts and links as an install checks them (${M_version:-no version}, $(prompt_bytes "$n" "$d") B of prompt, $I_hd1)"
  [ "$M_has" = 1 ] || t_warn "$n" "no .henki/module.toml: an index lists only modules with one (name, version, license); fix: henki mods new shows one"
  [ "$n" = "${d##*/}" ] || t_warn "$n" "the directory is named ${d##*/}: a URL install names the module after its manifest, a path one after the directory too; fix: rename one"
  ! skill_reserved "$n" || t_fail "$n" "a name henki keeps for itself, or an official module's; fix: rename the module"
  # A command name in two modules stops henki at start when both are on.
  for o in $(official_names); do
    [ "$o" != "$n" ] && x=$(official_dir "$o") || continue
    for c in $(printf '%s' "$I_runs" | awk -F '\t' '$1 ~ /^(bin|cmd)\// { print $1 }'); do
      [ ! -e "$x/$c" ] || t_warn "$n" "$c is also the official module $o's; henki does not start with both on; fix: rename it"
    done
  done
  [ ! -d "$d/eval" ] || t_ok "$n" "eval/: $(printf '%s' "$E_tasks" | awk 'NF' | wc -l | tr -d ' ') tasks (eval/1)"
  for p in $(printf '%s' "$I_ports"); do
    C_suite="$(conform_dir)/$p.tsv" || die "no conformance suites found; fix: reinstall henki"
    if ! h=$(henki_bin 2>/dev/null); then
      t_fail "$n" "port/$p: no henki to run the $p/1 suite with; fix: put henki on PATH"
    elif conform_run "$p" "$d/port/$p" "$h" >"$STAGE/conform"; then
      t_ok "$n" "port/$p passes the $p/1 suite ($C_checks checks)"
    else
      sed 's/^/     | /' "$STAGE/conform"
      t_fail "$n" "port/$p fails the $p/1 suite (above); fix: as each FAIL line says"
    fi
  done
  command -v shellcheck >/dev/null 2>&1 || return 0
  for p in $(printf '%s' "$I_runs" | cut -f 1) .henki/template; do
    [ -f "$d/$p" ] && [ ! -L "$d/$p" ] || continue
    case "$(head -n 1 "$d/$p")" in '#!'*/sh | '#!'*/bash | '#!'*' sh' | '#!'*' bash') ;; *) continue ;; esac
    shellcheck -S warning "$d/$p" >"$STAGE/sc" 2>&1 || t_warn "$n" "shellcheck on $p:$nl$(sed 's/^/     | /' "$STAGE/sc")"
  done
}

# test [DIR]: test_module on DIR, or on each module in DIR (default .) and then DIR/test.sh, run in DIR with a
# scratch home; exit 1 on any FAIL. It runs the module's code (the suites, test.sh): an author's own, on purpose.
dev_test() {
  local d="${1:-.}" m n=0 rc=0
  [ -d "$d" ] || die "$d is not a directory; fix: name a module directory, or the one that holds modules"
  d=$(cd -P "$d" && pwd) || die "cannot enter $1; fix: make it readable"
  if [ -f "$d/doc.md" ]; then
    test_module "$d"
  else
    for m in "$d"/*/; do
      m=${m%/}
      [ -f "$m/doc.md" ] || continue
      n=$((n + 1))
      test_module "$m"
    done
    [ "$n" -gt 0 ] || die "$d holds no module (a directory holding doc.md); fix: name one, or make one with henki mods new NAME"
    if [ -f "$d/test.sh" ]; then
      scratch_home test
      (cd "$d" && in_scratch sh ./test.sh) >"$STAGE/own" 2>&1 || rc=$?
      sed 's/^/     | /' "$STAGE/own"
      if [ "$rc" = 0 ]; then t_ok test.sh "exit 0 (a scratch home)"; else t_fail test.sh "exit $rc (above)"; fi
      rm -rf "$T_root"
    fi
  fi
  [ "$T_fail" = 0 ] || die "$T_fail checks failed (the FAIL lines above); fix: as each one says"
  say "test: ok"
}

# --- try ---------------------------------------------------------------------------------------------------------------

# try [DIR|NAME] [--keep] [-- HENKI_ARGS]: henki with only one module on, in a scratch home: HOME and the four XDG dirs
# under a new temp dir, the config.toml of this config dir (without its ext key) copied in, the module added there
# from DIR (default .) or as add takes NAME, then henki run with HENKI_ARGS. The temp dir goes at the end, but with
# --keep. Nothing of the try reaches this config dir, the store or the state dir, nor anything of those the try.
dev_try() {
  local src="" keep=0 h rc=0 out line
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep=1 ;;
      --)
        shift
        break
        ;;
      -*) usage ;;
      *) [ -z "$src" ] && src=$1 || usage ;;
    esac
    shift
  done
  case "${HENKI_DEPTH:-0}" in 0) ;; *) die "try starts henki, and this runs inside henki (HENKI_DEPTH=$HENKI_DEPTH); fix: run henki mods try in a terminal outside henki" ;; esac
  src=${src:-.}
  case "$src" in
    . | .. | /* | ./* | ../*)
      [ -f "$src/doc.md" ] || die "$src is not a module (no doc.md); fix: name the module's directory, like ./NAME"
      src=$(cd -P "$src" && pwd) || die "cannot enter $src; fix: make it readable"
      ;;
  esac
  h=$(henki_bin) || exit 1
  scratch_home try
  if [ -f "$CONF/config.toml" ]; then
    awk '{ l = $0; sub(/^[ \t]+/, "", l) } l !~ /^ext[ \t]*=/' "$CONF/config.toml" >"$T_root/home/.config/henki/config.toml"
    chmod 600 "$T_root/home/.config/henki/config.toml"
  fi
  out=$(in_scratch "$SELF/henki-mods" add "$src" --yes 2>&1) || rc=$?
  printf '%s\n' "$out" | sed 's/^/  | /'
  if [ "$rc" != 0 ]; then
    rm -rf "$T_root"
    die "$src could not be added in the scratch home (above); fix: henki mods test $src"
  fi
  # A command that shadows one on PATH loads only with the shadow line add printed; the scratch config gets it.
  line=$(printf '%s\n' "$out" | sed -n 's/^add to .*: \(shadow = \[.*\]\)$/\1/p')
  if [ -n "$line" ]; then
    { awk '{ l = $0; sub(/^[ \t]+/, "", l) } l !~ /^shadow[ \t]*=/' "$T_root/home/.config/henki/config.toml" 2>/dev/null; printf '%s\n' "$line"; } >"$T_root/config.toml.new" &&
      mv -f "$T_root/config.toml.new" "$T_root/home/.config/henki/config.toml" && chmod 600 "$T_root/home/.config/henki/config.toml"
  fi
  say "try: henki with only that module, home $(shown "$T_root/home")$([ "$keep" = 1 ] || printf ' (removed at the end)')"
  rc=0
  in_scratch "$h" "$@" || rc=$?
  if [ "$keep" = 1 ]; then say "try: kept $T_root"; else chmod -R u+w "$T_root" 2>/dev/null; rm -rf "$T_root"; fi
  exit "$rc"
}

# --- publish -----------------------------------------------------------------------------------------------------------

# A git remote URL as an index's package names it: https, else the https form of a GitHub ssh URL; else nothing. A
# file:/// URL passes under HENKI_INDEX_ALLOW_FILE=1 (an index on a local disk, as the index's own lint allows).
https_url() {
  case "$1" in
    https://*) printf '%s\n' "$1" ;;
    git@github.com:*) printf 'https://github.com/%s\n' "${1#git@github.com:}" ;;
    ssh://git@github.com/*) printf 'https://github.com/%s\n' "${1#ssh://git@github.com/}" ;;
    file:///*) [ "${HENKI_INDEX_ALLOW_FILE:-}" != 1 ] || printf '%s\n' "$1" ;;
  esac
}

# publish [DIR]: for the module in DIR (default .), committed and pushed: the two index entry files, from the commit's
# raw blobs (entry derive, as the index's check does), checked by the index's own lint, then how to send them. Writes
# nothing anywhere.
dev_publish() {
  local d="${1:-.}" top rel head r remote url login n v h p
  [ -f "$d/doc.md" ] || die "$d is not a module (no doc.md); fix: name the module's directory"
  d=$(cd -P "$d" && pwd) || die "cannot enter $1; fix: make it readable"
  top=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) && top=$(cd -P "$top" && pwd) ||
    die "$d is not in a git work tree; fix: commit the module to a git repository and push it"
  rel=${d#"$top"}
  rel=${rel#/}
  [ -z "$(git -C "$top" status --porcelain --untracked-files=all -- "${rel:-.}")" ] ||
    die "$d has changes that are not committed; fix: commit them (an index entry pins a commit, and only its files)"
  head=$(git -C "$top" rev-parse -q --verify 'HEAD^{commit}') || die "$top has no commit; fix: commit the module"
  remote=""
  for r in $(git -C "$top" branch -r --contains "$head" 2>/dev/null | sed 's/^ *//; s/ .*//'); do
    remote=${r%%/*}
    break
  done
  if [ -z "$remote" ] && [ -n "$(git -C "$top" tag --contains "$head" 2>/dev/null)" ]; then remote=origin; fi
  [ -n "$remote" ] || die "no remote branch or tag holds $head; fix: push it (git push), so the index can name a commit others can fetch"
  url=$(git -C "$top" remote get-url "$remote" 2>/dev/null) || die "the remote $remote has no URL; fix: git remote add origin https://..."
  r=$(https_url "$url")
  [ -n "$r" ] || die "the remote URL $url is not https; fix: an index names an https URL: push to one and set it with git remote set-url $remote URL"
  url=$r
  entry_derive "file://$top" "$rel" "$head" >"$STAGE/ver.body"
  n=$I_name v=$M_version
  [ -n "$M_license" ] || die "$d/.henki/module.toml has no license; fix: set license"
  login=$M_maintainer
  case "$login" in '' | *[!A-Za-z0-9-]*) login="" ;; esac
  case "$url" in https://github.com/*/*) [ -n "$login" ] || login=${url#https://github.com/} login=${login%%/*} ;; esac
  [ -n "$login" ] || login=YOUR-GITHUB-LOGIN
  mkdir -p "$STAGE/ix/mods/$n"
  {
    printf 'index = 1\nname = "%s"\nkind = "git"\nrepo = "%s"\npath = "%s"\n' "$n" "$url" "$rel"
    printf 'summary = "%s"\nmaintainer = "%s"\nlicense = "%s"\n' "${M_summary:-$I_line}" "$login" "$M_license"
    printf 'latest = "%s"\nadded = "%s"\n' "$v" "$(date -u +%Y-%m-%d)"
  } >"$STAGE/ix/mods/$n.toml"
  {
    printf 'index = 1\n'
    cat "$STAGE/ver.body"
    for p in $(printf '%s' "$I_ports"); do
      C_suite="$(conform_dir)/$p.tsv" || die "no conformance suites found; fix: reinstall henki"
      h=$(henki_bin) || exit 1
      conform_run "$p" "$STAGE/m/port/$p" "$h" >"$STAGE/conform" || {
        cat "$STAGE/conform"
        die "port/$p fails the $p/1 suite (above); an index lists only bindings that pass; fix: henki mods test $1"
      }
      printf 'conform = "%s/1 %s/%s"\n' "$p" "$C_passed" "$C_checks"
      break
    done
  } >"$STAGE/ix/mods/$n/$v.toml"
  for p in "$STAGE/ix/mods/$n.toml" "$STAGE/ix/mods/$n/$v.toml"; do
    (entry_lint "$p" >/dev/null) || die "the entry above does not pass the index's checks; fix: as each line says (the manifest, or the module)"
  done
  say "# mods/$n.toml (a package the index does not list yet; for one it does, set only latest = \"$v\")"
  cat "$STAGE/ix/mods/$n.toml"
  say ""
  say "# mods/$n/$v.toml"
  cat "$STAGE/ix/mods/$n/$v.toml"
  say ""
  [ "$login" != YOUR-GITHUB-LOGIN ] || say "# set maintainer to your GitHub login (or maintainer in the manifest), then:"
  say "# to list it: fork $(cat "$(index_share)/$INDEX_DEFAULT.url" 2>/dev/null || echo the index), add the two files,"
  say "# run ./check.sh pr main HEAD there (the checks a reviewer runs first), and open a pull request. A reviewer reads"
  say "# the code at $head, adds reviewed and reviewer, and signs the merge. Nothing was sent anywhere."
}

# --- share -------------------------------------------------------------------------------------------------------------

# share NAME: the line that installs NAME's files on another machine: `add NAME` for an official or index module (the
# review travels with the name), else `add URL@COMMIT#DIR --expect hd1:H`, which installs these files or refuses.
dev_share() { # NAME
  local x
  lock_check
  lock_get "$1" || die "$1 is not added; fix: henki mods list shows what is"
  x=${L_source%%#*}@$L_commit
  case "$L_source" in *'#'*) x="$x#${L_source#*#}" ;; esac
  case "$L_kind:$L_source" in
    official:*) say "henki mods add $L_name" ;;
    index:"$INDEX_DEFAULT":*) say "henki mods add $L_source" ;;
    index:*) say "henki mods add $L_source@${L_kind#index:}   (once: henki mods index add ${L_kind#index:} URL --signers FILE)" ;;
    url:*) say "henki mods add $x --expect $L_hd1" ;;
    skill:[!/]*) say "henki mods add --skill $x --as $L_name --expect $L_hd1" ;;
    *) die "$1 comes from a directory on this machine ($L_source), which no one else can add; fix: push it to a git repository and share that (henki mods add URL#DIR)" ;;
  esac
  x=$(masks_of)
  [ -z "$x" ] || say "(here $(printf '%s\n' "$x" | sed 's|^|/|' | tr '\n' ' ')is masked; the line installs the whole module)"
}

setup
case "${1:-}" in
  entry)
    case "${2:-}" in
      derive)
        [ $# = 5 ] || usage
        scratch
        entry_derive "$3" "$4" "$5"
        ;;
      lint)
        [ $# = 3 ] || usage
        scratch
        entry_lint "$3"
        ;;
      *) usage ;;
    esac
    ;;
  new) shift && scratch && dev_new "$@" ;;
  test)
    [ $# -le 2 ] || usage
    scratch
    dev_test "${2:-}"
    ;;
  try) shift && scratch && dev_try "$@" ;;
  publish)
    [ $# -le 2 ] || usage
    scratch
    dev_publish "${2:-}"
    ;;
  share)
    [ $# = 2 ] && is_name "$2" || usage
    scratch
    dev_share "$2"
    ;;
  help | -h | --help)
    usage 2>&1 | sed 's/^usage: //;s/^       //'
    exit 0
    ;;
  --version)
    [ $# = 1 ] || usage
    say "henki-mods-dev $(henki_version)"
    ;;
  *) usage ;;
esac
