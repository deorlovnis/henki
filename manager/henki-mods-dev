#!/usr/bin/env bash
# henki-mods-dev: the module author's tools, beside henki-mods (`henki mods new|test|try|publish|share|entry ...` reach
# them through it). It takes henki-mods' functions (it sources henki-mods, which stops before its own verbs), so a
# module is read here by the rules it is installed by. Bash 3.2 compatible, as henki-mods.
#
#   henki-mods-dev new NAME [--tool|--cmd|--template|--observer EVENT|--port history] [--dir D]
#       a working module of that kind in D/NAME (D default ./NAME), and around a first one test.sh, README.md and a
#       0BSD LICENSE: a tool for the model (bin/NAME, with an eval/ task), a command for the person that hands back a
#       message (cmd/NAME), a prompt template (cmd/NAME.md), an observer (on/EVENT), or a history binding in bash
#   henki-mods-dev test [DIR]
#       the checks an install makes, plus the names henki keeps, the official modules' commands, each port/PORT's
#       conformance suite and shellcheck (when installed), on module DIR or on each module in DIR (default .), then
#       DIR/test.sh in DIR with HOME and the XDG dirs in a scratch dir. It runs the module's code
#   henki-mods-dev try [DIR|NAME] [--keep] [-- HENKI_ARGS]
#       henki with only that module on (added from DIR, default ., or as add takes NAME), HOME and the four XDG dirs in a
#       scratch dir holding a copy of this config.toml without its ext key; the scratch dir goes at the end
#   henki-mods-dev publish [DIR]
#       for the committed and pushed module DIR: mods/NAME.toml and mods/NAME/VERSION.toml for the index, derived from
#       the commit and checked by the index's lint; writes nothing anywhere
#   henki-mods-dev share NAME
#       one line that installs NAME's files elsewhere: add NAME (official, index) or add URL@COMMIT#DIR --expect hd1:H
#   henki-mods-dev entry derive REPO PATH COMMIT
#       the keys of an index version file (index/1) that the module itself decides, for the module in directory PATH
#       ("" for the root) of git repository REPO at the full commit COMMIT: version, commit, hd1, requires, contracts,
#       os, ports, commands, bins, observers, ctx, prompt_bytes, card_bytes and caps_net. Read from the commit's raw
#       blobs, as `henki-mods add` copies a module; no code of the module runs. The index's own check.sh compares a
#       version file against this.
#   henki-mods-dev entry lint FILE
#       one entry file, mods/NAME.toml (a package) or mods/NAME/VERSION.toml (a version), against the index's rules; a
#       version may still lack its review (reviewed, reviewer and asset checks are the reviewer's to add)
set -u
p="$0"
while [ -L "$p" ]; do
  t=$(readlink "$p") || break
  case "$t" in /*) p=$t ;; *) p="$(dirname "$p")/$t" ;; esac
done
# shellcheck source=manager/henki-mods
. "$(cd -P "$(dirname "$p")" && pwd)/henki-mods" || exit 1

usage() {
  cat >&2 <<'EOF'
usage: henki-mods-dev new NAME [--tool|--cmd|--template|--observer EVENT|--port history] [--dir D]
                                                 a working module to start from, in D (default ./NAME)
       henki-mods-dev test [DIR]                 the checks of module DIR, or of each module in DIR (default .), then
                                                 DIR/test.sh in a scratch home
       henki-mods-dev try [DIR|NAME] [--keep] [-- HENKI_ARGS]
                                                 henki with only that module on, in a scratch home
       henki-mods-dev publish [DIR]              the index entry files for the committed, pushed module DIR
       henki-mods-dev share NAME                 one line that installs these files of NAME on another machine
       henki-mods-dev entry derive REPO PATH COMMIT   the derived keys of an index version file
       henki-mods-dev entry lint FILE                 one index entry file (mods/NAME.toml, mods/NAME/VERSION.toml)
       henki-mods-dev help | --version
EOF
  exit 2
}

# A TOML array of the lines of LIST: ["a", "b"].
toml_array() { printf '%s\n' "$1" | awk 'NF { s = s (n++ ? ", " : "") "\"" $0 "\"" } END { print "[" s "]" }'; }

# The names under DIR/ in the listing (STAGE_LIST) that henki takes as entries: no .md data, no dot files.
listed() { HM_D="$1/" awk -F '\t' 'BEGIN { d = ENVIRON["HM_D"] } index($1, d) == 1 { n = substr($1, length(d) + 1); if (index(n, "/") == 0 && n !~ /\.md$/ && n !~ /^\./) print n }' "$STAGE_LIST"; }

entry_derive() { # REPO PATH COMMIT
  local repo="$1" path="$2" commit="$3" x fallback b
  case "$commit" in *[!0-9a-f]*) commit=x ;; esac
  [ ${#commit} = 40 ] || die "\"$3\" is not a full commit id; fix: give all 40 hex digits (an entry pins a commit, never a branch)"
  case "/$path/" in *//* | */./* | */../*) [ -z "$path" ] || die "\"$path\" is not a directory path in the repository; fix: give it like mods/NAME, or \"\" for the root" ;; esac
  x=${repo%/}
  x=${x##*/}
  fallback=${path##*/}
  fallback=${fallback:-${x%.git}}
  copy_git "$repo" "$commit" "$path" "$STAGE/m"
  inspect "$STAGE/m" "$fallback" 0 || die "$(printf '%s' "$ERR" | sed "s|$STAGE/m|$repo${path:+#$path}|g")"
  [ "$M_has" = 1 ] || die "$repo${path:+#$path}: no .henki/module.toml; fix: an indexed module has a manifest (name, version, license)"
  b=$(prompt_bytes "$I_name" "$STAGE/m")
  [ "$b" = 0 ] || b=$((b + ${#HEADER} + 2))
  printf 'version = "%s"\n' "$M_version"
  printf 'commit = "%s"\n' "$COMMIT"
  printf 'hd1 = "%s"\n' "$I_hd1"
  printf 'requires = %s\n' "$(toml_array "$M_requires")"
  printf 'contracts = %s\n' "$(toml_array "$M_contracts")"
  printf 'os = %s\n' "$(toml_array "$M_os")"
  printf 'ports = %s\n' "$(toml_array "$M_ports")"
  printf 'commands = %s\n' "$(toml_array "$(listed cmd)")"
  printf 'bins = %s\n' "$(toml_array "$(listed bin)")"
  printf 'observers = %s\n' "$(toml_array "$(listed on)")"
  printf 'ctx = %s\n' "$(toml_array "$(listed ctx)")"
  printf 'prompt_bytes = %s\n' "$b"
  printf 'card_bytes = %s\n' "$I_card"
  printf 'caps_net = "%s"\n' "${M_caps:-none}"
  printf '%s' "$M_assets" | awk -F '\t' 'NF == 4 { printf "asset_%s = [\"%s\", \"%s\", \"%s\"]\n", $1, $2, $3, $4 }'
}

entry_lint() { # FILE
  local f="$1" n v k kind why out
  [ -f "$f" ] && [ ! -L "$f" ] || die "$f is not a regular file; fix: name an entry file"
  case "/$f" in
    */mods/*/*.toml)
      v=${f##*/}
      v=${v%.toml}
      n=${f%/*}
      n=${n##*/}
      k=ver
      ;;
    */mods/*.toml)
      n=${f##*/}
      n=${n%.toml}
      k=pkg
      ;;
    *) die "$f is neither mods/NAME.toml nor mods/NAME/VERSION.toml; fix: name the file in an index's tree" ;;
  esac
  why=$(invisible_check "$f") || die "$f holds $why, which a terminal does not show; fix: remove it"
  out=$(toml <"$f") || die "$f:$out"
  printf '%s\n' "$out" | command grep -v '^$' >"$STAGE/rec"
  if [ "$k" = pkg ]; then
    out=$(lint_pkg "$STAGE/rec" "$n" "$f")
  else
    kind=git
    if [ -f "${f%/*}.toml" ] && toml <"${f%/*}.toml" >"$STAGE/pkg" 2>/dev/null; then kind=$(rget "$STAGE/pkg" kind) || kind=git; fi
    out=$(CK_PR=1 lint_ver "$STAGE/rec" "$v" "$kind" "$f")
  fi
  if [ -n "$out" ]; then
    printf 'henki-mods-dev: %s\n' "$out" >&2
    die "entry lint: $(printf '%s\n' "$out" | wc -l | tr -d ' ') problems (above); fix: as each one says"
  fi
  say "$f: ok"
}

# --- new: the skeletons --------------------------------------------------------------------------------------------------
# Each kind is a working module that `test` passes and `add` installs. The text is fixed but for NAME (and EVENT), so
# the module template repository can hold exactly what `new` writes (its check.sh compares the two).

# stdin into FILE with mode MODE, @NAME@ and @EVENT@ replaced (both are [A-Za-z0-9._-], safe in sed).
put() { # FILE MODE
  mkdir -p "${1%/*}" && sed "s/@NAME@/$N_name/g; s/@EVENT@/$N_event/g" >"$1" && chmod "$2" "$1" ||
    die "cannot write $1; fix: make its directory writable"
}

# The manifest of the new module: CONTRACTS (the formats it is written for) and PORTS.
new_manifest() { # CONTRACTS PORTS
  put "$N_dir/.henki/module.toml" 644 <<EOF
# The manifest (module/1). henki-mods shows it on the install screen and checks it before anything goes on; henki
# itself never reads it. Unknown keys are refused; CONTRACTS.md module/1 lists them all.
henki_module = 1
# The module's name: keep it the directory's.
name = "@NAME@"
# A label for people (an index wants MAJOR.MINOR.PATCH); an install is pinned by commit and tree hash, not by this.
version = "0.1.0"
# An SPDX id or expression; the index takes the licenses its CONTRIBUTING.md lists.
license = "0BSD"
requires = ["henki >= 0.2"]
# The formats it is written for (CONTRACTS.md); a henki-mods that lacks one refuses the module. An index wants each
# array sorted, without repeats.
contracts = [$1]
os = ["linux", "macos"]
# Where its programs connect: none, loopback or any (declared for the reader, not enforced).
caps_net = "none"
# The ports its port/ programs bind (port/1), each once henki-mods swap binds it.
ports = [$2]
EOF
}

new_tool() {
  put "$N_dir/doc.md" 644 <<'EOF'
# greets someone by name: `@NAME@ [WHO]`; an example command that changes nothing

`@NAME@ [WHO]` prints `hello, WHO` on stdout (WHO defaults to `world`). It reads no files, writes none and connects
nowhere, so it is always safe to run.

- `@NAME@ --help` prints the usage.
- Exit codes: 0 greeted; 2 usage (more than one WHO, or an unknown option), with the problem on stderr.

Example: `@NAME@ henki` prints `hello, henki`. A name with spaces is one argument: `@NAME@ "the reader"`.
EOF
  put "$N_dir/bin/$N_name" 755 <<'EOF'
#!/bin/sh
# @NAME@: a command for the model. What makes it a good one, and worth keeping in yours: a --help, one line per problem
# on stderr that says what to do next, and the exit codes the doc lists.
set -eu
case "${1:-}" in
  -h | --help)
    echo 'usage: @NAME@ [WHO]'
    echo 'prints "hello, WHO" (WHO defaults to world)'
    exit 0
    ;;
  -*)
    echo "@NAME@: unknown option $1; fix: run @NAME@ --help" >&2
    exit 2
    ;;
esac
if [ $# -gt 1 ]; then
  echo "@NAME@: takes one WHO, got $#; fix: quote a name that holds spaces" >&2
  exit 2
fi
printf 'hello, %s\n' "${1:-world}"
EOF
  put "$N_dir/eval/greet/prompt.txt" 644 <<'EOF'
Greet the reader with the @NAME@ command, then tell me exactly what it printed.
EOF
  put "$N_dir/eval/greet/setup" 755 <<'EOF'
#!/bin/sh
# Makes the task's files in the empty work dir it runs in (EVAL_DIR is the task's own dir). This task needs none.
exit 0
EOF
  put "$N_dir/eval/greet/check" 755 <<'EOF'
#!/bin/sh
# Exit 0 is a pass. It runs in the work dir after henki, with the model's last answer on stdin.
grep -q 'hello, the reader'
EOF
  new_manifest '"eval/1", "ext/2", "module/1"' ''
}

new_cmd() {
  put "$N_dir/doc.md" 644 <<'EOF'
# /@NAME@ [TEXT]: puts a message about this directory up as your next one; an example command for you

`/@NAME@` in henki runs `cmd/@NAME@` on your terminal; the model is not told, and the module costs no prompt bytes.
It hands henki a message asking the model to describe the files here, with TEXT after it, which henki shows and sends
when you press Enter (`send? [Y/n]`). Outside henki it says so and exits 2.
EOF
  put "$N_dir/cmd/$N_name" 755 <<'EOF'
#!/bin/sh
# /@NAME@ [TEXT]: a command for you (handoff/1). henki runs it on your terminal when you type /@NAME@, with TEXT as one
# argument. What it writes into the file $HENKI_NEXT names is handed back to henki: `send`, then a text, puts the text
# up as your next message. It may also print, ask on the terminal and run anything you could.
set -eu
if [ -z "${HENKI_NEXT:-}" ]; then
  echo "@NAME@: run it in henki as /@NAME@; fix: start henki and type /@NAME@" >&2
  exit 2
fi
{
  echo send
  printf 'List the files in %s and say in one line each what it is for.\n' "$PWD"
  if [ -n "${1:-}" ]; then printf '\n%s\n' "$1"; fi
} >"$HENKI_NEXT"
EOF
  new_manifest '"ext/2", "handoff/1", "module/1"' ''
}

new_template() {
  put "$N_dir/doc.md" 644 <<'EOF'
# /@NAME@ [TEXT]: sends a prepared prompt, with TEXT after it; an example template for you

`/@NAME@` in henki shows the prompt in `cmd/@NAME@.md`, then TEXT after a blank line, and sends it as your next message
when you press Enter (`send? [Y/n]`). The model is not told, and the module costs no prompt bytes. Edit
`cmd/@NAME@.md` for another prompt; for more of them, add `cmd/OTHER.md` and the link `cmd/OTHER -> ../.henki/template`.
EOF
  put "$N_dir/cmd/$N_name.md" 644 <<'EOF'
Explain what the code in this directory does: find where it starts, read the main files, and say in plain words what
each part is for and how they connect, naming the files. Do not change any file.
EOF
  skill_template 0 | put "$N_dir/.henki/template" 755
  ln -s ../.henki/template "$N_dir/cmd/$N_name" || die "cannot link $N_dir/cmd/$N_name; fix: check the disk"
  new_manifest '"ext/2", "handoff/1", "module/1"' ''
}

new_observer() {
  put "$N_dir/doc.md" 644 <<'EOF'
# keeps a log of henki's @EVENT@ events in $HENKI_STATE/@NAME@/events.jsonl; an example observer

henki runs `on/@EVENT@` once per `@EVENT@` event, unasked, with the event as one JSON line on stdin (observe/1); it
appends the line to `events.jsonl` in the dir `@NAME@` of henki's state dir (`~/.local/state/henki`). Nothing an
observer does changes the session, and the module costs no prompt bytes.
EOF
  put "$N_dir/on/$N_event" 755 <<'EOF'
#!/bin/sh
# on/@EVENT@: an observer (observe/1). henki runs it once per @EVENT@ event, unasked, in a process group of its own,
# with the event as one JSON line on stdin; its exit status and output change nothing. Keep it quick, and leave no
# process behind.
set -eu
log="$HENKI_STATE/@NAME@/events.jsonl"
mkdir -p "${log%/*}"
cat >>"$log"
EOF
  new_manifest '"ext/2", "module/1", "observe/1"' ''
}

new_port() {
  put "$N_dir/doc.md" 644 <<'EOF'
# a history binding that keeps henki's sessions as files, one per session; an example to make your own

`henki mods swap history @NAME@` binds it once its conformance suite passes (`henki mods test --port history ./@NAME@`
runs the suite here); `henki mods swap history std` goes back. `port/history` speaks port/1 and history/1 on stdin and
stdout: each session is `ID.jsonl` (one record per line) with its scope in `ID.scope`, in the state dir its hello
names, and a held session is the dir `ID.lock` holding the holder's pid. It is a start: it does not fsync.
EOF
  put "$N_dir/port/history" 755 <<'EOF'
#!/usr/bin/env bash
# @NAME@: a history/1 binding in bash. henki writes canonical lines (compact, keys sorted), so sed and parameter
# expansion can take them apart. Each session is STATE/ID.jsonl (one record per line) with its scope in STATE/ID.scope;
# STATE is the dir hello names. A session is held by the dir STATE/ID.lock holding the holder's pid; a lock whose pid is
# gone (a SIGKILL) is taken over. Durable here means in the file before the answer, which a SIGKILL of either side does
# not undo (no fsync).
set -u
state=. held="" fresh=0 gone=0
str() { printf '%s' "$1" | sed -n 's/.*"'"$2"'":"\([^"\\]*\)".*/\1/p'; }
answer() { printf '{"id":%s,%s}\n' "$id" "$1"; }
fail() { answer "\"error\":{\"code\":\"$1\",\"message\":\"$2\"}"; }
take() {
  local l="$state/$1.lock"
  mkdir "$l" 2>/dev/null || { kill -0 "$(cat "$l/pid" 2>/dev/null)" 2>/dev/null && return 1; rm -rf "$l" && mkdir "$l"; } || return 1
  echo $$ >"$l/pid" && held=$1 fresh=0 gone=0
}
release() { [ -z "$held" ] || rm -rf "$state/$held.lock"; held=""; }
newest() { # SCOPE: the session ids of SCOPE, newest first
  local f
  for f in $(ls -t "$state" 2>/dev/null | sed -n 's/\.jsonl$//p'); do
    [ "$(cat "$state/$f.scope" 2>/dev/null)" = "$1" ] && echo "$f"
  done
}
while IFS= read -r line; do
  id=$(printf '%s' "$line" | sed -n 's/^{"id":\([0-9]*\),.*/\1/p')
  method=$(printf '%s' "$line" | sed -n 's/^{"id":[0-9]*,"method":"\([^"]*\)".*/\1/p')
  s=$(str "$line" session)
  case "$method" in
    hello)
      v=$(printf '%s' "$line" | sed -n 's/.*"versions":\[\([0-9,]*\)\].*/\1/p')
      case ",$v," in *,1,*) ;; *) fail version "@NAME@ speaks history/1 only" && continue ;; esac
      state=$(str "$line" state) && mkdir -p "$state"
      answer '"result":{"caps":[],"impl":"0.1.0","name":"@NAME@","protocol":1,"version":1}'
      ;;
    create)
      h=$(str "$line" hint)
      [ -z "$h" ] || [ ! -e "$state/$h.jsonl" ] || { fail exists "session $h exists" && continue; }
      release
      s=${h:-s-$$-$RANDOM$RANDOM}
      : >"$state/$s.jsonl" && str "$line" scope >"$state/$s.scope" && take "$s" && fresh=1
      answer "\"result\":{\"session\":\"$s\"}"
      ;;
    open)
      release
      [ -z "$s" ] || [ -e "$state/$s.jsonl" ] || { fail not_found "no session $s" && continue; }
      for c in ${s:-$(newest "$(str "$line" scope)")}; do take "$c" && break; done
      if [ -n "$held" ]; then answer "\"result\":{\"session\":\"$held\"}"; elif [ -n "$s" ]; then fail busy "session $s is in use"; else fail not_found "no session to open"; fi
      ;;
    read)
      [ -n "$s" ] && [ -e "$state/$s.jsonl" ] || { fail not_found "no session $s" && continue; }
      from=$(printf '%s' "$line" | sed -n 's/.*"from":\([0-9]*\).*/\1/p')
      answer "\"result\":{\"records\":[$(tail -n +$((${from:-0} + 1)) "$state/$s.jsonl" | paste -s -d , -)]}"
      ;;
    append)
      [ -n "$s" ] && [ "$s" = "$held" ] || { fail not_found "session $s is not held" && continue; }
      rec=${line#*\"params\":\{\"record\":}
      rec=${rec%,\"session\":*}
      case "$rec" in '{'*) ;; *) fail invalid "a record is a JSON object" && continue ;; esac
      [ "$gone" = 1 ] || printf '%s\n' "$rec" >>"$state/$s.jsonl"
      answer '"result":null'
      ;;
    discard)
      [ -n "$s" ] && [ "$s" = "$held" ] || { fail not_found "session $s is not held" && continue; }
      if [ "$fresh" = 1 ] && [ "$gone" = 0 ] && ! grep -q '"t":"user"' "$state/$s.jsonl"; then
        rm -f "$state/$s.jsonl" "$state/$s.scope" && gone=1
      fi
      if [ "$gone" = 1 ]; then answer '"result":{"removed":true}'; else answer '"result":{"removed":false}'; fi
      ;;
    list)
      out=""
      for c in $(newest "$(str "$line" scope)"); do
        out="$out${out:+,}{\"session\":\"$c\",\"updated\":$(date -r "$state/$c.jsonl" +%s 2>/dev/null || echo 0)}"
      done
      answer "\"result\":{\"sessions\":[$out]}"
      ;;
    bye) release && answer '"result":null' && exit 0 ;;
    *) fail unsupported "no method $method" ;;
  esac
done
release
EOF
  new_manifest '"ext/2", "history/1", "module/1", "port/1"' '"history"'
}

