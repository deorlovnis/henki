#!/bin/sh
# A prompt template (handoff/1): hands back `send` with the text of cmd/NAME.md, NAME the command this runs as (a link
# to this file), and the command's argument after a blank line when there is one.
name=${0##*/}
{
  echo send
  cat "$HENKI_MODULE/cmd/$name.md" || exit 1
  if [ -n "${1:-}" ]; then printf '\n%s\n' "$1"; fi
} >"$HENKI_NEXT"
