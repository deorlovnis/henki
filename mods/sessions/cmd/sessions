#!/bin/sh
# /sessions, and through links to this file /resume, /new, /reload and /fork (handoff/1). The sessions are this
# folder's in the store henki keeps them in, std's or a bound history binding's: `henki mods history` reads either.
LC_ALL=C
export LC_ALL
me=${0##*/}
next() { printf '%s\n' "$1" >"$HENKI_NEXT"; }
history() { "${HENKI_BIN:-henki}" mods history "$@"; }
# The ids of `history list`'s lines (` N M ID DATE  FIRST`, M `*` for this session or blank), as `N ID`.
ids() { awk '$1 ~ /^[0-9]+$/ { print $1, ($2 == "*" ? $3 : $2) }'; }
case "$me" in
  new) next new && exit 0 ;;
  reload) next restart && exit 0 ;;
  sessions) exec "${HENKI_BIN:-henki}" mods history list --scope "$PWD" ;;
  resume)
    want=${1:-}
    list=$(history list --scope "$PWD" --all) || exit 1
    case "$want" in
      '') id=$(printf '%s\n' "$list" | ids | ME=${HENKI_SESSION:-} awk '$2 != ENVIRON["ME"] { print $2; exit }') ;;
      *[!0-9]*) id=$(printf '%s\n' "$list" | ids | W=$want awk '$2 == ENVIRON["W"] { print $2; exit }') ;;
      *) id=$(printf '%s\n' "$list" | ids | W=$want awk '$1 == ENVIRON["W"] { print $2; exit }') ;;
    esac
    if [ -z "$id" ]; then
      echo "resume: no session ${want:-other than this one} in this folder; fix: /sessions lists them" >&2
      exit 1
    fi
    next "resume $id"
    exit 0
    ;;
esac
# /fork [N | ID@N]: a new session holding this session's (or ID's) records before line N, a user message, to which
# the next message goes instead. Without N: the session's messages by line, then the question.
arg=${1:-}
id=${HENKI_SESSION:-}
n=$arg
case "$arg" in *@*) id=${arg%@*} n=${arg##*@} ;; esac
shown=$(history show "$id") || exit 1
if [ -z "$n" ]; then
  printf '%s\n' "$shown"
  printf 'fork at line? '
  # No terminal to answer on (henki serve runs a command with stdin /dev/null): the line goes in the argument.
  read -r n || { echo >&2 && echo "fork: no line given, and no terminal to ask on; fix: /fork N with N a line above" >&2 && exit 1; }
fi
case "$n" in '' | 0* | *[!0-9]*)
  echo "fork: \"$n\" is not a line; fix: /fork N, N one of the lines /fork alone lists" >&2
  exit 1
  ;;
esac
if ! printf '%s\n' "$shown" | N=$n awk 'NR > 1 && $1 == ENVIRON["N"] { f = 1 } END { exit !f }'; then
  echo "fork: line $n of session $id is not a message of yours; fix: /fork lists them" >&2
  exit 1
fi
if [ -n "${HENKI_NEXT:-}" ]; then next "resume $id@$n"; else echo "henki --resume=$id@$n"; fi
