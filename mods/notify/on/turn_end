#!/bin/sh
# on/turn_end, and on/question through a link to this file (observe/1): a desktop notification when a turn ends or
# henki asks before a call, through osascript (macOS) or notify-send (Linux) when there is one. No terminal bell: an
# observer has no terminal.
LC_ALL=C
# The notifier comes from the system dirs, never the tool PATH: a PATH dir inside the project (an activated .venv/bin)
# holds what the model wrote there, and this runs on the host after each turn. HENKI_NOTIFY_PATH replaces them (tests).
PATH=${HENKI_NOTIFY_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin}
export LC_ALL PATH
ev=$(cat)
case "${HENKI_EVENT:-}" in
  question) what="asks before a $(printf '%s\n' "$ev" | sed -n 's/.*"name":"\([^"]*\)","t":"ask".*/\1/p') call" ;;
  *) what="turn ended: $(printf '%s\n' "$ev" | sed -n 's/.*"status":"\([a-z_]*\)".*/\1/p')" ;;
esac
title="henki: ${PWD##*/}"
if command -v osascript >/dev/null 2>&1; then
  # The text goes in as arguments, never into the script.
  exec osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$title" "$what"
fi
if command -v notify-send >/dev/null 2>&1; then
  exec notify-send -- "$title" "$what"
fi
echo "notify: no osascript or notify-send in $PATH" >&2
