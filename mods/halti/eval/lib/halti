def status():
    own = own_ws()
    for w in workspaces():
        if ws_state(w) == "open":
            running = [b for b in boxes_of(w) if box_state(w, b) == "running"]
            print("%-10s open    closes in 87 min   plan %-8s  boxes: %-22s jobs: none%s" % (
                w, "personal" if w == own else "team-a", ", ".join("%s (running)" % b for b in running) or "none running", "   own" if w == own else ""))
        else:
            print("%-10s closed%s" % (w, "  own" if w == own else ""))
    return 0


def ls_ws(ws, flags):
    if ws_state(ws) != "open" and "--expiring" in [f.split("=")[0] for f in flags]:
        print("unknown: %s is closed" % ws)
        return 2
    read_closed(ws)
    c = effective(ws) or {}
    idx = index()
    keys = []
    for s in c.get("sites", []):
        meta = idx.get(s, {})
        exp = min([f.get("expires") for f in meta.get("fields", {}).values() if f.get("expires")] or ["unknown"])
        days = (datetime.date.fromisoformat(exp) - TODAY).days if exp != "unknown" else None
        rc = canon_resource(read(res_file(s), "")) if read(res_file(s)) else {}
        f = rc.get("fetch") or {}
        var = ", ".join((rc.get("run") or {}).get("export", {}).values()) or "-"
        keys.append((days if days is not None else 99999, "%s (%s; sent to %s; writes %s; expires %s%s)" % (
            s, var, ", ".join(f.get("hosts", [])) or "no hosts", f.get("writes", "deny"), exp, "" if days is None else ", in %d days%s" % (days, " !" if days <= 14 else ""))))
    keys.sort()
    if "--expiring" in [f.split("=")[0] for f in flags]:
        lim = int(([f.split("=")[1] for f in flags if f.startswith("--expiring=")] or ["14"])[0])
        due = [k for d, k in keys if d <= lim]
        print("\n".join(due) if due else "%s: no keys expire within %d days" % (ws, lim))
        return 1 if due else 0
    print("%s: %s%s" % (ws, ws_state(ws), "  (own)" if ws == own_ws() else "  (client)"))
    print("rules: %s (%s)" % (box_file(ws), "CHANGED since approval, not in effect: halti policy %s" % ws if pending(ws) else "approved"))
    for b in boxes_of(ws):
        print("box %s: image %s, %s, cpus %s, memory %s%s" % (b, image_label(ws), box_state(ws, b), c.get("cpus"), c.get("memory"), ", docker" if c.get("docker") else ""))
    print("repos: %s" % (", ".join("%s (box main)" % r for r in repos(ws)) or "none"))
    print("keys:")
    for _d, k in keys:
        print("  " + k)
    if not keys:
        print("  none")
    print("hosts agents may read: %s" % (", ".join(c.get("net", {}).get("allow", [])) or "none"))
    print("writes to hosts no key covers: %s%s" % (c.get("net", {}).get("writes", "deny"),
          ("; allowed anyway: " + ", ".join(c["net"]["allow_writes"])) if c.get("net", {}).get("allow_writes") else ""))
    rl = refusal_lines(ws)
    print("refused today:%s" % ("\n" + "\n".join(rl) if rl else " none"))
    print("jobs: none")
    return 0


def cmd_log(ws, flags, args):
    read_closed(ws)
    lines = (read(sp("doorlog", ws + ".log"), "") or "").splitlines()
    if "--refused" in flags:
        lines = [l for l in lines if "REFUSED" in l]
    if "-n" in argv:
        try:
            n = int(argv[argv.index("-n") + 1])
            lines = lines[-n:]
        except (ValueError, IndexError):
            die("-n needs a number")
    print("%s door log, today (all boxes; secrets masked):" % ws)
    for l in lines:
        print(l)
    rl = refusal_lines(ws)
    print("refused today:%s" % ("\n" + "\n".join(rl) if rl else " none"))
    return 0


def run_in_box(ws, name, rest, claude):
    box, sub = "main", None
    if name:
        if name in boxes_of(ws):
            box = name
        elif name in repos(ws):
            sub = name
        else:
            die("no box or repo %r in %s; boxes: %s; repos: %s" % (name, ws, ", ".join(boxes_of(ws)), ", ".join(repos(ws)) or "none"))
    started = ensure_open(ws, start=box if box_state(ws, box) != "running" else None)
    if box_state(ws, box) != "running":
        set_box(ws, box, "running")
        door(ws, "halti started box %s" % box)
        started = True
    print("%s/%s, image %s%s:" % (ws, box, image_label(ws), " (started)" if started else " (joined the running box)"), flush=True)
    wd = workdir(ws)
    start_dir = os.path.join(wd, sub) if sub else wd
    if claude:
        print("would start claude %s in %s (fake)" % (" ".join(rest), "/work" + ("/" + sub if sub else "")))
        return 0
    if not rest:
        print("would open an interactive bash in /work (fake); the box keeps running")
        return 0
    cmd = " ".join(rest)
    cmd2 = re.sub(r"(?<![\w.\-/])/work(?![\w.-])", wd, cmd)
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": sp("home", ws), "TERM": "dumb", "LANG": "C.UTF-8", "PWD": start_dir}
    c = effective(ws) or {}
    for s in c.get("standins", []):
        env[s] = "cred-managed"
    os.makedirs(env["HOME"], exist_ok=True)
    r = subprocess.run(["/bin/sh", "-c", cmd2], cwd=start_dir, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True)
    sys.stdout.write(r.stdout.replace(wd, "/work"))
    sys.stderr.write(r.stderr.replace(wd, "/work"))
    sys.stdout.flush()
    return r.returncode


def stop(ws, name, close=False):
    stopped = []
    for b in boxes_of(ws):
        if (name in (None, b)) and box_state(ws, b) == "running":
            set_box(ws, b, "stopped")
            door(ws, "halti stopped box %s" % b)
            stopped.append(b)
    if name and name not in boxes_of(ws):
        die("no box %r in %s; boxes: %s" % (name, ws, ", ".join(boxes_of(ws))))
    if close:
        set_ws(ws, "closed")
        print("%s: closed (stopped %s; store locked)" % (ws, ", ".join(stopped) or "no box was running"))
    else:
        print("%s: stopped %s. %s is still open; `halti close %s` locks it" % (ws, ", ".join("box " + b for b in stopped) or "nothing (no box was running)", ws, ws))
    return 0


def key_of(arg):
    """WS/KEY -> (ws, key), the key must be in WS's sites."""
    ws, key = ws_of(arg)
    if not key:
        die("name a key: %s/KEY" % ws)
    sites = (effective(ws) or {}).get("sites", [])
    if key not in sites:
        die("%s has no key %r; its keys: %s" % (ws, key, ", ".join(sites) or "none"))
    return ws, key


def allow(args, flags):
    if not args:
        die("usage: halti allow WS HOST | WS URL --writes | WS/KEY --uploads | WS")
    if "--uploads" in flags:
        ws, key = key_of(args[0])
        touch("%s: agents may upload files to the storage URLs %s's own service hands them" % (ws, key), "approve", ws)
        append(sp("uploads"), "%s/%s" % (ws, key))
        print("%s: agents may now upload to %s's upload URLs (running boxes updated)" % (ws, key))
        return 0
    ws, _ = need_ws_typed(args[0], "allow")
    if len(args) < 2:
        rl = refusal_lines(ws)
        print("%s refusals today:%s" % (ws, ("\n" + "\n".join(rl)) if rl else " none"))
        return 0
    what = args[1]
    path = box_file(ws)
    text = read(path)
    net = raw_net(text)
    if "--writes" in flags:
        u = urlsplit(what)
        if u.scheme != "https" or not u.hostname:
            die("--writes takes a URL prefix like https://api.example.com/v1/ (what you typed: %s)" % what)
        if any(u.hostname == h or u.hostname.endswith("." + h) for h in SHARED_HOSTS):
            die("%s is a shared host (anyone can create a bucket there); writes to it are refused. For a key's uploads: halti allow %s/KEY --uploads" % (u.hostname, ws), 1)
        cur = list(net.get("allow_writes", []))
        if what in cur:
            print("%s: agents may already write to %s" % (ws, what))
            return 0
        new = set_list_in_toml(text, "net", "allow_writes", cur + [what])
    else:
        if what == "*" or "*" in what:
            die("allow takes one host; opening the whole web is a rules change: halti policy %s" % ws)
        host = urlsplit(what).hostname if "://" in what else what.rstrip("/")
        if not host or "." not in host or "/" in host or ":" in host:
            die("allow takes a host with a dot, like docs.gradle.org (for writes: a URL with --writes)")
        origin = "https://" + host.lower()
        cur = list(net.get("allow", []))
        try:
            have = {site_text(e) for e in cur}
        except PolicyError:
            have = set()
        if origin in have or "*" in have:
            if pending(ws):
                return approve(["box." + ws])
            print("%s: agents may already read %s" % (ws, origin))
            return 0
        new = set_list_in_toml(text, "net", "allow", cur + [origin])
    return approve(["box." + ws], {"box." + ws: new})


def policy(args, flags):
    if not args:
        die("usage: halti policy WS | halti policy approve [NAME...] | halti policy edit NAME")
    if args[0] == "approve":
        names = args[1:]
        if not names:
            names = ["box." + w for w in workspaces()] + resources()
        else:
            for n in names:
                if n not in workspaces() and n not in resources():
                    die("no policy %r; boxes: %s; keys: %s" % (n, ", ".join(workspaces()), ", ".join(resources())))
            names = [approval_name(n) for n in names]
        return approve(names, show_text=True)
    if args[0] in ("edit", "show"):
        if len(args) < 2:
            die("usage: halti policy %s NAME" % args[0])
        n = args[1]
        if n not in workspaces() and n not in resources():
            die("no policy %r; boxes: %s; keys: %s" % (n, ", ".join(workspaces()), ", ".join(resources())))
        path = file_of(approval_name(n))
        if args[0] == "show":
            print(read(path), end="")
            return 0
        die("policy edit opens $EDITOR and needs a terminal. Without one: edit %s, then run `halti policy %s` to approve it (Touch ID)" % (path, n))
    ws, _ = need_ws_typed(args[0], "policy")
    if not pending(ws):
        print("%s: rules are in %s and approved; edit that file, then run `halti policy %s` again to approve the change (Touch ID). "
              "(In a terminal this opens $EDITOR.)" % (ws, box_file(ws), ws))
        return 0
    return approve(["box." + ws], show_text=True)


def info(args):
    if not args:
        die("usage: halti info KEY")
    r = args[0]
    if r not in resources():
        die("no key %r; keys: %s" % (r, ", ".join(resources())))
    t, c = approved(r)
    c = c or canon_resource(read(res_file(r)))
    f = c.get("fetch") or {}
    meta = index().get(r, {})
    print("%s: %s" % (r, meta.get("description", "")))
    print("policy: %s (%s)" % (res_file(r), "approved" if t == read(res_file(r)) else "CHANGED since approval"))
    for fn, fm in sorted(meta.get("fields", {}).items()):
        print("field %s: updated %s, expires %s" % (fn, fm.get("updated", "?"), fm.get("expires", "unknown")))
    print("halti run: %s, exports %s" % (c["run"]["mode"], ", ".join("%s as %s" % kv for kv in c["run"]["export"].items()) or "nothing"))
    print("sent to: %s; writes there: %s" % (", ".join(f.get("hosts", [])) or "nowhere", f.get("writes", "deny")))
    print("used by: %s" % (", ".join(w for w in workspaces() if r in (effective(w) or {}).get("sites", [])) or "no box"))
    return 0


def release(ws, keys, to):
    """A credential leaves halti for a process or the clipboard: one touch per call, naming the command.
    Every release is recorded in $STATE/released.log, which checks read."""
    touch("%s: release key%s %s to %s" % (ws, "s" if len(keys) > 1 else "", ", ".join(keys), to), "release", ws)
    for key in keys:
        append(sp("released.log"), "%s\t%s/%s\t%s" % (now(), ws, key, to))
        if ws in workspaces():
            door(ws, "halti released key %s to %s (on the Mac)" % (key, to))
    return [FAKE_VALUES.get(key, "HALTIFAKE0" + key) for key in keys]


def copy(args):
    if len(args) < 2:
        die("usage: halti copy SRC... DEST (WS:PATH for a workspace's /work; a bare word is a Mac path)")
    src, dest = args[:-1], args[-1]
    wss = workspaces()
    if len(args) == 2 and args[0] in resources() and not os.path.exists(args[0]) and args[1] in index().get(args[0], {}).get("fields", {}):
        # The older form, `halti copy RES FIELD`: the value goes to the clipboard after a Touch ID.
        res, field = args
        v = release(res, [res], "the clipboard (field %s)" % field)[0]
        write(sp("clipboard"), v)
        print("copied %s %s to the clipboard; it is cleared in 30 s" % (res, field))
        return 0
    if dest in wss or any(s in wss for s in src):
        bad = dest if dest in wss else [s for s in src if s in wss][0]
        die("did you mean %s:? use ./%s for the folder" % (bad, bad))

    def side(p):
        if ":" in p and p.split(":")[0] in wss:
            w, rest = p.split(":", 1)
            rest = rest[6:] if rest.startswith("/work" + "/") else rest
            return w, os.path.join(workdir(w), rest or "in")
        return None, os.path.abspath(p)
    dw, dpath = side(dest)
    names = []
    for s in src:
        sw, spath = side(s)
        if not os.path.isfile(spath):
            die("%s: no such file" % s)
        names.append((s, spath, sw))
    touch("copy %s -> %s" % (", ".join(n[0] for n in names), dest), "copy", ",".join(sorted({w for w in [dw] + [n[2] for n in names] if w})) or "-")
    for s, spath, sw in names:
        target = os.path.join(dpath, os.path.basename(spath)) if (os.path.isdir(dpath) or dest.endswith(("/", ":"))) else dpath
        if os.path.exists(target):
            die("%s exists; copy never overwrites" % target, 1)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        data = open(spath, "rb").read()
        open(target, "wb").write(data)
        for w in {sw, dw} - {None}:
            door(w, "halti copy %s -> %s (%d bytes)" % (s, dest, len(data)))
        print("%s -> %s  %d bytes  sha256 %s" % (s, dest, len(data), hashlib.sha256(data).hexdigest()[:16]))
    return 0


def with_(args, rest):
    if not args or not rest:
        die("usage: halti with WS/KEY... -- CMD")
    pairs = [key_of(a) for a in args]
    ws = {w for w, _ in pairs}
    if len(ws) != 1:
        die("with takes keys of one workspace")
    ws = ws.pop()
    if ws != own_ws():
        die("with is off for client workspaces (%s); `halti policy %s` can allow it. Run the command in the box instead: halti sh %s -- CMD" % (ws, ws, ws), 1)
    if os.path.basename(rest[0]) in ("claude", "codex", "henki", "aider", "gemini"):
        die("with never runs agent CLIs", 1)
    env = dict(os.environ)
    values = release(ws, [k for _w, k in pairs], "`%s` on this Mac" % " ".join(rest))
    for (w, k), v in zip(pairs, values):
        meta = canon_resource(read(res_file(k), "")) if read(res_file(k)) else {"run": {"export": {}}}
        for var in (meta["run"]["export"].values() or [k.upper() + "_TOKEN"]):
            env[var] = v
        if k == "github":
            env["GH_TOKEN"] = env["GITHUB_TOKEN"] = v
    r = subprocess.run(rest, env=env, capture_output=True, text=True)
    out, err = r.stdout, r.stderr
    for v in values:
        out, err = out.replace(v, "********"), err.replace(v, "********")
    sys.stdout.write(out)
    sys.stderr.write(err)
    return r.returncode


def set_(args, flags):
    if not args or "/" not in args[0]:
        die("usage: halti set WS/KEY [--expires D] [--delete]; the value comes from the hidden prompt or stdin, never the command line")
    if len(args) > 1:
        die("values are never taken on the command line; paste it at the hidden prompt or pipe it in", 2)
    ws, key = ws_of(args[0])
    if not key:
        die("usage: halti set WS/KEY")
    if "--delete" in flags:
        touch("%s: DELETE key %s for good (revokes it from every box)" % (ws, key), "other", ws)
        append(sp("sealed.log"), "%s\tdelete %s/%s" % (now(), ws, key))
        print("deleted %s/%s" % (ws, key))
        return 0
    val = "" if sys.stdin.isatty() else sys.stdin.read()
    if not val.strip():
        die("no value: paste it at the hidden prompt (in your own terminal) or pipe it in", 1)
    if key not in (effective(ws) or {}).get("sites", []):
        # every new credential is a new channel: one touch
        touch("%s: agents may use a new key %s" % (ws, key), "approve", ws)
    append(sp("sealed.log"), "%s\tset %s/%s (%d bytes)" % (now(), ws, key, len(val.strip())))
    print("sealed %s/%s (%d bytes, value not shown)" % (ws, key, len(val.strip())))
    return 0


