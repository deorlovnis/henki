def box_verb(args, flags, rest):
    sub = args[0] if args else None
    if sub not in BOXV:
        die("halti box needs one of: %s" % " ".join(BOXV))
    a = args[1:]
    if sub == "ls":
        return status()
    if sub in ("new", "delete") and not a:
        die("usage: halti box %s WS/BOX" % sub)
    if sub == "new":
        ws, b = need_ws_typed(a[0], "box new")
        touch("%s: new box %s" % (ws, b or "?"), "approve", ws)
        print("box new %s: done (fake: the fake keeps one box, main, per workspace)" % a[0])
        return 0
    if sub == "delete":
        ws, b = need_ws_typed(a[0], "box delete")
        touch("%s: DELETE box %s for good; repos stay" % (ws, b or "main"), "other", ws)
        print("box delete %s: done (fake)" % a[0])
        return 0
    if sub == "approve":
        if not a:
            return approve(["box." + w for w in workspaces()], show_text=True)
        for n in a:
            if n not in workspaces():
                die("no box %r; boxes: %s" % (n, ", ".join(workspaces())))
        return approve(["box." + n for n in a], show_text=True)
    if sub == "edit":
        return policy(["edit"] + a, flags)
    if sub == "log":
        ws, _ = ws_of(a[0] if a else None, infer=True, verb="box log")
        return cmd_log(ws, flags, a)
    if sub == "stop":
        ws, b = ws_of(a[0] if a else None, infer=True, verb="box stop")
        return stop(ws, b)
    if sub == "run":
        ws, b = ws_of(a[0] if a else None, infer=True, verb="box run")
        return run_in_box(ws, b, rest, claude=not rest)


def main():
    if "--" in argv:
        head, rest = argv[: argv.index("--")], argv[argv.index("--") + 1:]
    else:
        head, rest = argv, []
    flags = [a for a in head if a.startswith("--")]
    pos = [a for a in head if not a.startswith("-")]
    if "-n" in head and head.index("-n") + 1 < len(head):
        pos = [a for i, a in enumerate(head) if not a.startswith("-") and not (i > 0 and head[i - 1] == "-n")]
    if "--version" in flags or "-V" in head:
        print("halti 0.0.0-fake (henki eval)")
        return 0
    if not pos and ("--help" in flags or "-h" in head):
        return usage()
    if not pos and not flags and "-n" not in head:
        # Bare `halti` is the manager agent (interactive); status is `halti ls`. Interactive verbs fail fast
        # when the caller is not a terminal.
        die("halti with no command starts the manager agent, which needs your own terminal. "
            "For the status of your workspaces: halti ls", 2)
    if pos == ["ls"]:
        return status()
    v, args = pos[0], pos[1:]
    if v == "help" or "--help" in flags:
        return usage()
    if v not in TOP:
        die("unknown command %r; commands: %s" % (v, " ".join(TOP)))
    a0 = args[0] if args else None
    if v == "mcp":
        die("halti mcp WS serves an agent over MCP on stdin/stdout; it is not a command to run from a shell", 2)
    if v == "ls":
        ws, _ = need_ws_typed(a0, "ls")
        return ls_ws(ws, flags)
    if v in ("run", "sh"):
        ws, name = ws_of(a0, infer=True, verb=v)
        return run_in_box(ws, name, rest, claude=(v == "run"))
    if v == "open":
        ws, _ = need_ws_typed(a0, "open")
        if not ensure_open(ws):
            print("%s is already open" % ws)
        else:
            print("%s: open (no box started)" % ws)
        return 0
    if v == "close":
        targets = workspaces() if "--all" in flags else ([ws_of(a)[0] for a in args] if args else [ws_of(None, infer=True, verb="close")[0]])
        for w in targets:
            stop(w, None, close=True)
        return 0
    if v == "stop":
        ws, b = ws_of(a0, infer=True, verb="stop")
        return stop(ws, b)
    if v == "log":
        ws, _ = ws_of(a0, infer=True, verb="log")
        return cmd_log(ws, flags, args)
    if v == "set":
        return set_(args, flags)
    if v == "allow":
        return allow(args, flags)
    if v == "policy":
        return policy(args, flags)
    if v == "info":
        return info(args)
    if v == "with":
        return with_(args, rest)
    if v == "copy":
        return copy(args)
    if v == "box":
        return box_verb(args, flags, rest)
    if v in ("login", "jobs", "clone"):
        ws, _ = need_ws_typed(a0, v)
        if v == "clone" and len(args) > 1 and args[1].startswith("https://"):
            print("cloned %s into %s:/work%s%s (fake; 0 touches for listed hosts)" % (args[1], ws, "/", args[1].rstrip("/").split("/")[-1].removesuffix(".git")))
            return 0
        touch({"login": "%s: seal a sign-in for %s", "jobs": "%s: run ticket jobs labelled halti-%s for 10 h", "clone": "%s: link a Mac repo (%s)"}[v]
              % (ws, args[1] if v != "jobs" and len(args) > 1 else ws), "approve", ws)
        print("%s %s: done (fake)" % (v, " ".join(args)))
        return 0
    if v == "temp":
        touch("temp-3f2a: throwaway workspace with %s" % (", ".join(args) or "nothing"))
        print("temp-3f2a: done (fake)")
        return 0
    if v == "backup":
        ws, _ = need_ws_typed(a0, "backup")
        print("backup %s -> %s/halti/%s: 0 changed (fake)" % (ws, args[1] if len(args) > 1 else "?", ws))
        return 0
    if v == "update":
        print("halti is up to date (fake)")
        return 0
    if v == "ws":
        sub = a0
        if sub not in WSV:
            die("halti ws needs one of: %s" % " ".join(WSV))
        target = args[1] if len(args) > 1 else None
        if sub == "plan" and target is None:
            print("plans: team-a (default), personal")
            return 0
        if target is None and sub != "migrate":
            die("usage: halti ws %s NAME" % sub)
        if sub not in ("new", "migrate", "restore"):
            ws_of(target)
        if sub != "undo":
            touch("ws %s %s" % (sub, target or ""))
        print("ws %s %s: done (fake)" % (sub, target or ""))
        return 0
    return 0


def harness():
    """--fake-init / --fake-snapshot, called by the eval's setup and check, never by the agent."""
    if "--fake-init" in argv:
        for w in workspaces():
            t = read(box_file(w))
            write(sp("approved", "box.%s.toml" % w), t)
            write(sp("approved", "box.%s.json" % w), dump(canon_box(t)))
            if not os.path.exists(sp("status", "ws", w)):
                set_ws(w, "closed")
            if not os.path.exists(sp("status", "box", w + ".main")):
                set_box(w, "main", "stopped")
            workdir(w)
        for r in resources():
            t = read(res_file(r))
            write(sp("approved", r + ".toml"), t)
            write(sp("approved", r + ".json"), dump(canon_resource(t)))
        for root, _d, files in os.walk(sp("box")):
            for f in files:
                if f.endswith(".sh"):
                    os.chmod(os.path.join(root, f), 0o755)
        return 0
    if "--fake-snapshot" in argv:
        for w in workspaces():
            try:
                out = dump(canon_box(read(box_file(w))))
            except PolicyError as e:
                out = dump({"error": str(e)})
            write(sp("current", "box.%s.json" % w), out)
        return 0
    return None


def entry():
    if argv and argv[0] in ("--fake-init", "--fake-snapshot"):
        sys.exit(harness())
    code = 0
    try:
        code = main() or 0
    except Exit as e:
        code = e.code
    except PolicyError as e:
        print("halti: %s" % e, file=sys.stderr)
        code = 1
    finally:
        if LOGF:
            os.makedirs(os.path.dirname(LOGF), exist_ok=True)
            with open(LOGF, "a") as f:
                f.write(" ".join(argv).replace("\n", " ") + "\n")
    sys.exit(code)


if __name__ == "__main__":
    entry()
